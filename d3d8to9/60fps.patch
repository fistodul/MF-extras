+// Cap the frame rate to 60 FPS using a precise wait in Present().
+void LimitFramerateTo60FPS()
+{
+    static LARGE_INTEGER frequency = {};
+    static LARGE_INTEGER nextFrameTime = {};
+    static bool initialized = false;
+
+    LARGE_INTEGER currentTime;
+    QueryPerformanceCounter(&currentTime);
+
+    if (!initialized)
+    {
+        QueryPerformanceFrequency(&frequency);
+        // Schedule the first real frame one full frame from now.
+        nextFrameTime.QuadPart = currentTime.QuadPart +
+            static_cast<LONGLONG>(static_cast<double>(frequency.QuadPart) / 60.0 + 0.5);
+        initialized = true;
+        return;
+    }
+
+    // If we're more than a second behind schedule (e.g. after a loading screen),
+    // reset the schedule so we don't try to "catch up" and spike the CPU.
+    if (currentTime.QuadPart > nextFrameTime.QuadPart + frequency.QuadPart)
+    {
+        nextFrameTime = currentTime;
+    }
+
+    // Wait until the target time for this frame.
+    if (currentTime.QuadPart < nextFrameTime.QuadPart)
+    {
+        const double waitMs =
+            static_cast<double>(nextFrameTime.QuadPart - currentTime.QuadPart) * 1000.0 /
+            static_cast<double>(frequency.QuadPart);
+
+        // Sleep for most of the wait, then spin for the last ~1 ms for precision.
+        if (waitMs > 1.5)
+        {
+            Sleep(static_cast<DWORD>(waitMs - 1.0));
+        }
+
+        do
+        {
+            QueryPerformanceCounter(&currentTime);
+        } while (currentTime.QuadPart < nextFrameTime.QuadPart);
+    }
+
+    // Advance the schedule by exactly one frame duration (no drift).
+    nextFrameTime.QuadPart +=
+        static_cast<LONGLONG>(static_cast<double>(frequency.QuadPart) / 60.0 + 0.5);
+}
